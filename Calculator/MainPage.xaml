<Page
    x:Class="Calculator.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseSystemFocusVisuals="True"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Center" ZoomMode="Disabled" Padding="48">
        <StackPanel MaxWidth="400" Margin="0">

            <TextBlock Text="Taschenrechner"
                       FontSize="28"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,12"/>

            <Border Background="#1F1F1F" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="ExpressionDisplay"
                               FontSize="20"
                               TextAlignment="Right"
                               Foreground="Gray"
                               Text=""
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="Display"
                               FontSize="48"
                               TextAlignment="Right"
                               Foreground="White"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="BtnClear"
                        Grid.Row="0" Grid.Column="0"
                        Content="C"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Background="#E74C3C" Foreground="White"
                        Click="Button_Click"
                        XYFocusUp="Btn0" XYFocusDown="Btn7" XYFocusLeft="BtnDivide" XYFocusRight="BtnPlusMinus"/>
                <Button x:Name="BtnPlusMinus"
                        Grid.Row="0" Grid.Column="1"
                        Content="±"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="BtnEquals" XYFocusDown="Btn8" XYFocusLeft="BtnClear" XYFocusRight="BtnPercent"/>
                <Button x:Name="BtnPercent"
                        Grid.Row="0" Grid.Column="2"
                        Content="%"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="BtnEquals" XYFocusDown="Btn9" XYFocusLeft="BtnPlusMinus" XYFocusRight="BtnDivide"/>
                <Button x:Name="BtnDivide"
                        Grid.Row="0" Grid.Column="3"
                        Content="÷"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Background="#0078D7" Foreground="White"
                        Click="Button_Click"
                        XYFocusUp="BtnEquals" XYFocusDown="BtnMultiply" XYFocusLeft="BtnPercent" XYFocusRight="BtnClear"/>

                <Button x:Name="Btn7"
                        Grid.Row="1" Grid.Column="0"
                        Content="7"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="BtnClear" XYFocusDown="Btn4" XYFocusLeft="BtnMultiply" XYFocusRight="Btn8"/>
                <Button x:Name="Btn8"
                        Grid.Row="1" Grid.Column="1"
                        Content="8"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="BtnPlusMinus" XYFocusDown="Btn5" XYFocusLeft="Btn7" XYFocusRight="Btn9"/>
                <Button x:Name="Btn9"
                        Grid.Row="1" Grid.Column="2"
                        Content="9"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="BtnPercent" XYFocusDown="Btn6" XYFocusLeft="Btn8" XYFocusRight="BtnMultiply"/>
                <Button x:Name="BtnMultiply"
                        Grid.Row="1" Grid.Column="3"
                        Content="×"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Background="#0078D7" Foreground="White"
                        Click="Button_Click"
                        XYFocusUp="BtnDivide" XYFocusDown="BtnSubtract" XYFocusLeft="Btn9" XYFocusRight="Btn7"/>

                <Button x:Name="Btn4"
                        Grid.Row="2" Grid.Column="0"
                        Content="4"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="Btn7" XYFocusDown="Btn1" XYFocusLeft="BtnSubtract" XYFocusRight="Btn5"/>
                <Button x:Name="Btn5"
                        Grid.Row="2" Grid.Column="1"
                        Content="5"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="Btn8" XYFocusDown="Btn2" XYFocusLeft="Btn4" XYFocusRight="Btn6"/>
                <Button x:Name="Btn6"
                        Grid.Row="2" Grid.Column="2"
                        Content="6"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="Btn9" XYFocusDown="Btn3" XYFocusLeft="Btn5" XYFocusRight="BtnSubtract"/>
                <Button x:Name="BtnSubtract"
                        Grid.Row="2" Grid.Column="3"
                        Content="−"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Background="#0078D7" Foreground="White"
                        Click="Button_Click"
                        XYFocusUp="BtnMultiply" XYFocusDown="BtnAdd" XYFocusLeft="Btn6" XYFocusRight="Btn4"/>

                <Button x:Name="Btn1"
                        Grid.Row="3" Grid.Column="0"
                        Content="1"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="Btn4" XYFocusDown="Btn0" XYFocusLeft="BtnAdd" XYFocusRight="Btn2"/>
                <Button x:Name="Btn2"
                        Grid.Row="3" Grid.Column="1"
                        Content="2"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="Btn5" XYFocusDown="Btn0" XYFocusLeft="Btn1" XYFocusRight="Btn3"/>
                <Button x:Name="Btn3"
                        Grid.Row="3" Grid.Column="2"
                        Content="3"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="Btn6" XYFocusDown="Btn0" XYFocusLeft="Btn2" XYFocusRight="BtnAdd"/>
                <Button x:Name="BtnAdd"
                        Grid.Row="3" Grid.Column="3"
                        Content="+"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Background="#0078D7" Foreground="White"
                        Click="Button_Click"
                        XYFocusUp="BtnSubtract" XYFocusDown="BtnEquals" XYFocusLeft="Btn3" XYFocusRight="Btn1"/>

                <Button x:Name="Btn0"
                        Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="0"
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Click="Button_Click"
                        XYFocusUp="Btn2" XYFocusDown="BtnClear" XYFocusLeft="BtnEquals" XYFocusRight="BtnEquals"/>
                <Button x:Name="BtnEquals"
                        Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2"
                        Content="="
                        FontSize="24"
                        MinHeight="64" MinWidth="64"
                        Margin="4"
                        Background="#FF8C00" Foreground="White"
                        Click="Button_Click"
                        XYFocusUp="BtnAdd" XYFocusDown="BtnPercent" XYFocusLeft="Btn0" XYFocusRight="Btn0"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
